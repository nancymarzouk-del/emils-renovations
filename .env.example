# Emil's Renovations — environment variables
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is git-ignored; never commit real secrets.

# --- Contact form email delivery (Resend) ---
# Create an account at https://resend.com and generate an API key.
# Leave unset in development to use "preview mode" (form works, sends nothing).
RESEND_API_KEY=

# Where consultation inquiries are delivered.
# Production destination (owner-provided):
CONTACT_TO_EMAIL=Embak69@yahoo.com

# The "From" address shown on delivered inquiries.
# Must be a domain/sender VERIFIED in your Resend account.
# For quick testing you may use Resend's shared sender, which only delivers to
# your own Resend account email:
#   CONTACT_FROM_EMAIL="Emil's Renovations <onboarding@resend.dev>"
# For production to an external inbox (e.g. Yahoo), verify a domain and use it:
#   CONTACT_FROM_EMAIL="Emil's Renovations <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# --- Site metadata ---
# Public production URL (used for absolute OG/Twitter image URLs).
NEXT_PUBLIC_SITE_URL=
